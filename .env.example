# Discord
DISCORD_TOKEN=your_bot_token_here
# Needed when registering Discord slash/context commands from Docker Compose.
DISCORD_APP_ID=your_app_id_here

# App profile
# Selects the default root app when using npm run dev/start/register.
# Use "guild" for Babel Guild or "pocket" for Babel Pocket.
# Set BABEL_APP=pocket when deploying Babel Pocket for User Install workflows.
BABEL_APP=guild

# Dashboard
# Railway sets PORT automatically. Local Docker/VPS deploys can use DASHBOARD_PORT.
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PASSWORD=change_me

# Persistence
# Required for VPS/Docker deployments so SQLite lives in the mounted /app/data volume.
BABEL_DB_PATH=/app/data/babel.sqlite

# Runtime
# Required for VPS/Docker deployments. Production mode rejects unsafe dashboard defaults.
NODE_ENV=production
