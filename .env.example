# Discord
DISCORD_TOKEN=your_bot_token_here

# App profile
# Selects the default root app when using npm run dev/start/register.
# Use "guild" for Babel Guild or "pocket" for Babel Pocket.
BABEL_APP=guild

# Dashboard
# Railway sets PORT automatically. Local Docker/VPS deploys can use DASHBOARD_PORT.
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PASSWORD=change_me

# Persistence (optional)
# For Docker/Compose, use /app/data/babel.sqlite so the database lives in the mounted volume.
# BABEL_DB_PATH=/app/data/babel.sqlite
