# Discord
DISCORD_TOKEN=your_bot_token_here
# Needed when registering Discord slash/context commands from Docker Compose.
DISCORD_APP_ID=your_app_id_here
# Optional profile-specific Discord credentials for BABEL_APP=combined.
# Use these when Babel Guild and Babel Pocket are separate Discord applications.
BABEL_GUILD_DISCORD_TOKEN=
BABEL_GUILD_DISCORD_APP_ID=
BABEL_POCKET_DISCORD_TOKEN=
BABEL_POCKET_DISCORD_APP_ID=

# App profile
# Selects the default root app when using npm run dev/start/register.
# Use "guild" for Babel Guild, "pocket" for Babel Pocket, or "combined" to run both.
# Set BABEL_APP=pocket for User Install workflows, or combined to run Guild and Pocket together.
BABEL_APP=guild

# Dashboard
# Railway sets PORT automatically. Local Docker/VPS deploys can use DASHBOARD_PORT.
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PASSWORD=
# Dashboard runtime mode:
# - full: full admin dashboard, health, metrics (default)
# - health-only: health and metrics endpoints only, lower memory
# - off: no HTTP server; update host healthchecks before using
BABEL_DASHBOARD_MODE=full
# Optional for localhost/private monitoring. In NODE_ENV=production with
# DASHBOARD_HOST=0.0.0.0, /metrics requires a token even when this is empty.
# Scrapers pass Authorization: Bearer <token> or x-metrics-token: <token>.
BABEL_METRICS_TOKEN=

# Persistence
# Required for VPS/Docker deployments so SQLite lives in the mounted /app/data volume.
BABEL_DB_PATH=/app/data/babel.sqlite

# Runtime
# Required for VPS/Docker deployments. Production mode rejects unsafe dashboard defaults.
NODE_ENV=production
# Optional Docker memory tuning. Defaults are conservative for small communities.
BABEL_NODE_MAX_OLD_SPACE_MB=64
BABEL_NODE_MAX_SEMI_SPACE_MB=4
