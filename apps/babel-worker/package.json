{
  "name": "@babel-discord-translator/worker",
  "version": "0.2.2",
  "description": "Cloudflare Workers runtime for Babel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to=.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply babel-worker --local",
    "db:migrate:remote": "wrangler d1 migrations apply babel-worker --remote"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
