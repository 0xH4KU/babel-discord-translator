{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "babel-discord-translator",
    "main": "src/index.ts",
    "compatibility_date": "2026-07-11",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "babel.lum.bio", "custom_domain": true }],
    "vars": {
        "BABEL_APP": "combined",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "babel-worker",
            "database_id": "86e1e4c3-3ee9-4ec1-9918-91c771052149",
            "migrations_dir": "migrations",
        },
    ],
    "assets": {
        "directory": "../../src/public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*",
            "/guild/api/*",
            "/pocket/api/*",
            "/livez",
            "/readyz",
            "/healthz",
            "/metrics",
            "/interactions",
            "/guild/interactions",
            "/pocket/interactions",
        ],
        "not_found_handling": "single-page-application",
    },
    "observability": {
        "enabled": true,
    },
}
