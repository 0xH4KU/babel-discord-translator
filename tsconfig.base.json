{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024", "DOM"],
        "module": "Node20",
        "moduleResolution": "Node16",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "esModuleInterop": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    }
}
