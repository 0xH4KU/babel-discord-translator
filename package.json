{
  "name": "babel-discord-translator",
  "version": "0.3.0",
  "description": "Self-hosted Discord translation bot with Vertex AI and OpenAI-compatible providers, cost controls, and a web dashboard",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "start:guild": "npm start -- guild",
    "start:pocket": "npm start -- pocket",
    "dev": "tsx watch src/index.ts",
    "dev:guild": "npm run dev -- guild",
    "dev:pocket": "npm run dev -- pocket",
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "build:assets": "node scripts/copy-assets.js",
    "build:guild": "npm run build",
    "build:pocket": "npm run build",
    "typecheck": "tsc --noEmit",
    "register": "tsx scripts/register.ts",
    "register:guild": "npm run register -- guild",
    "register:pocket": "npm run register -- pocket",
    "register:built": "node dist/scripts/register.js",
    "register:built:guild": "npm run register:built -- guild",
    "register:built:pocket": "npm run register:built -- pocket",
    "db:migrate": "tsx scripts/migrate-json-to-sqlite.ts",
    "db:export:json": "tsx scripts/export-sqlite-to-json.ts",
    "db:migrate:built": "node dist/scripts/migrate-json-to-sqlite.js",
    "db:export:json:built": "node dist/scripts/export-sqlite-to-json.js",
    "demo:build": "tsx scripts/build-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ scripts/ tests/",
    "smoke:dashboard": "node scripts/smoke-dashboard-build.js",
    "format": "prettier --write ."
  },
  "keywords": [
    "discord",
    "translation",
    "bot",
    "gemini",
    "vertex-ai",
    "openai-compatible",
    "discord.js",
    "multilingual"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xH4KU/babel-discord-translator"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.9"
  }
}
